---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { resolvePath } from "@/lib/base-url";
import AircraftSpecs from "@/components/fleet/AircraftSpecs.astro";
import PilotList from "@/components/fleet/PilotList.astro";
import type { FleetData } from "@/types/fleet";
import { ROLE_LABELS } from "@/types/fleet";
import fleetData from "@/data/fleet/aircraft.json";
import "../../styles/pages/_fleet.scss";

const { note } = fleetData as FleetData;

export function getStaticPaths() {
  const fleet = fleetData as FleetData;
  return fleet.aircraft.map((a) => ({
    params: { slug: a.slug },
    props: { aircraft: a },
  }));
}

const { aircraft: current } = Astro.props;
const heroImage = resolvePath(current.imagen);
---

<BaseLayout
  title={`${current.codigo} ${current.nombre} | Flota | Escuadrón 71`}
  description={`${current.codigo} ${current.nombre} del Escuadrón 71: rol ${ROLE_LABELS[current.rol].toLowerCase()}, tareas ${current.tareas.join(", ")} y especificaciones en DCS World.`}
>
  <main role="main">
    <section class="aircraft-hero hero relative overflow-hidden">
      <picture class="absolute top-0 left-0 right-0 bottom-0 w-full h-full z-0">
        <img
          src={heroImage}
          alt={`${current.codigo} ${current.nombre}`}
          class="w-full h-full object-cover"
          loading="eager"
        />
      </picture>
      <div
        class="aircraft-hero__overlay absolute top-0 left-0 right-0 bottom-0 z-0"
        aria-hidden="true"
      ></div>
      <div class="container z-1">
        <div class="aircraft-hero__content">
          <span class="fleet-eyebrow">Flota del escuadrón</span>
          <h1 class="aircraft-hero__title">{current.codigo}</h1>
          <p class="aircraft-hero__name">{current.nombre}</p>
          <ul class="aircraft-hero__badges">
            <li>{ROLE_LABELS[current.rol]}</li>
            <li>{current.pais}</li>
            {current.tareas.map((task) => (
              <li>{task}</li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section class="section aircraft-section">
      <div class="container aircraft-layout">
        <div class="aircraft-main">
          <AircraftSpecs aircraft={current} />
          <PilotList aircraft={current} note={note} />
        </div>

        <aside class="aircraft-aside" aria-label="Información del módulo">
          <div class="aircraft-module">
            <h2>Módulo oficial en DCS</h2>
            <p>
              Adquiere el módulo {current.codigo} en la tienda oficial de
              Eagle Dynamics para volarlo en el escuadrón.
            </p>
            <a
              href={current.moduloOficialUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              Ver módulo en DCS
            </a>
            <a
              class="aircraft-module__back"
              href={resolvePath("/flota")}
            >
              Volver a la flota
            </a>
          </div>
        </aside>
      </div>
    </section>
  </main>
</BaseLayout>
