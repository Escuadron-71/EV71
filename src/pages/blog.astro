---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { resolvePath } from "@/lib/base-url";
import "../styles/pages/_stub.scss";
---

<BaseLayout
  title="Blog | Escuadrón 71"
  description="Blog del Escuadrón 71: artículos, guías y crónicas de la comunidad de simulación aérea."
>
  <main class="stub-page" role="main">
    <div class="stub-panel">
      <span class="stub-eyebrow">En construcción</span>
      <h1 class="stub-title">Blog</h1>
      <p class="stub-description">
        Próximamente: artículos, guías y crónicas de la comunidad del escuadrón.
      </p>
      <a class="stub-back" href={resolvePath("/")}>Regresar al inicio</a>
    </div>
  </main>
</BaseLayout>
