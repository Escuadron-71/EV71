---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Postulacion | Escuadron 71"
  description="Modulo de postulacion para aspirantes del Escuadron 71."
>
  <main class="page">
    <section class="panel">
      <span>Modulo de aspirante</span>
      <h1>Postulacion de ingreso</h1>
      <p>
        Esta ruta ya esta preparada en Astro. El formulario legado de postulacion
        sera migrado aqui por secciones para conservar validaciones, datos y flujo
        de revision del Estado Mayor.
      </p>
      <a href="/">Volver al inicio</a>
    </section>
  </main>
</BaseLayout>

<style>
  .page {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 32px;
    background:
      linear-gradient(135deg, rgba(5, 8, 12, 0.82), rgba(18, 25, 34, 0.92)),
      url("/assets/images/entrenamiento-t45.png") center/cover no-repeat;
  }

  .panel {
    width: min(100%, 760px);
    padding: 34px;
    background: rgba(17, 24, 33, 0.92);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    box-shadow: var(--shadow-panel);
  }

  span,
  a {
    color: var(--color-accent);
    font-weight: 800;
    text-transform: uppercase;
  }

  h1 {
    margin: 12px 0;
    font-family: "Oswald", sans-serif;
    font-size: clamp(2.6rem, 7vw, 5rem);
    line-height: 1;
    text-transform: uppercase;
  }

  p {
    max-width: 620px;
    color: var(--color-muted);
    font-size: 1.2rem;
    line-height: 1.6;
  }

  a {
    display: inline-block;
    margin-top: 16px;
    text-decoration: none;
  }
</style>
