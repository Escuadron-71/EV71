---
// src/pages/login.astro
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/UI/Icon.astro";

// Definir los iconos y textos
const loginOptions = [
  {
    id: 'piloto',
    label: 'Piloto',
    icon: 'ev71-pilot',
    href: '/login#piloto',
    description: 'Acceso para pilotos'
  },
  {
    id: 'instructor',
    label: 'Instructor',
    icon: 'ev71-instructor',
    href: '/login#instructor',
    description: 'Acceso para instructores'
  }
];
---

<BaseLayout
  title="Ingreso Academia | Escuadron 71"
  description="Ingreso al Dashboard de Piloto o Instructor del Escuadron 71"
>

  <main>
    <section id="ev71-select-login" class="relative h-dvh overflow-hidden">
      <div class="video-container">

        {/* En esta parte seria donde iria el video realmente, el video actualmente esta dentro dela carpeta "public/assets/video" */}
        {/* El video tiene que ir en Autoplay, muted y Loop */}
        {/* El video se llama "ev71-dcs.webm" */}
        <img 
          class="w-full! object-cover! max-h-dvh" 
          src="https://simulationdaily.com/wp-content/uploads/2024/12/b1bbc3d0-dcs-world-f5e-remastered.jpg" 
          alt="F5E Tiger II"
        />
      </div>
      
      <article class="absolute top-0 left-0 right-0 bottom-0 w-full h-full flex justify-center items-center bg-[linear-gradient(to_bottom,rgba(17,24,38,0.5),rgba(17,24,38,0.8))]">
        <div class="row bg-primary p-5 rounded-2xl border border-secondary">
          <div class="container">
            <div class="content-header text-center py-5">
              <h1 class="text-brand text-2xl!">Ingreso a la plataforma del <br /> <span class="text-secondary">Escuadron 71</span></h1>
            </div>
          </div>
          
          <div class="container">
            <div class="content flex flex-grap gap-4 justify-center">

              {loginOptions.map((option) => (
                <div class="content-login_user w-62.5">
                  <a 
                    href={option.href}
                    class="flex flex-col items-center gap-2 p-4 rounded-lg hover:bg-white/10 transition-colors"
                  >
                    <Icon name={option.icon} size={100} fill="var(--color-tertiary-light)" />
                    
                    <h2 class="text-brand uppercase text-xl! text-secondary">{option.label}</h2>
                    <p class="text-white/60 text-sm">{option.description}</p>
                  </a>
                </div>
              ))}

            </div>
          </div>
        </div>
      </article>
    </section>

    <section id="ev71-login-form">
      <form method="post">
        {/* Aqui vendria el formulario correspondiente para el inicio de sesion, campo1: correo o callSiogn, campo2: contraseña */}
        {/* El formulario debe de tener la misma estetica que el formulario actual de "Postulate" */}
      </form>
    </section>
    
    <section id="ev71-password-form">
      <form method="post">
        {/* Aqui vendria el formulario correspondiente para la recuperacion de contraseña, campo: correo */}
        {/* El formulario debe de tener la misma estetica que el formulario actual de "Postulate" */}
      </form>
    </section>
    
  </main>
</BaseLayout>