---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { resolvePath } from "@/lib/base-url";
import '../styles/pages/_login.scss';
import Icon from "@/components/UI/Icon.astro"

const base = resolvePath("/");
---

<BaseLayout
  title="Ingreso Academia | Escuadron 71"
  description="Ingreso al Dashboard de Piloto o Instructor del Escuadron 71"
>
  <main>
    <section class="login-page">

      {/* Video de fondo */}
      <video class="login-video" autoplay muted loop playsinline>
        <source src={`${base}assets/videos/ev71-dcs.webm`} type="video/webm" />
      </video>

      {/* Overlay oscuro */}
      <div class="login-overlay"></div>

      {/* Card central */}
      <article class="login-card">
        <h1>Ingreso a la plataforma del <br /><span>Escuadron 71</span></h1>

        {/* Tab selector Piloto / Instructor */}
        <div class="login-tabs" role="tablist">
          <button
            role="tab"
            aria-selected="true"
            aria-controls="panel-login"
            data-tab="piloto"
            class="flex flex-col justify-center items-center-safe"
          >
            <Icon name="ev71-pilot" size={75} stroke="2" />
            <span>Piloto</span>
          </button>
          <button
            role="tab"
            aria-selected="false"
            aria-controls="panel-login"
            data-tab="instructor"
            class="flex flex-col justify-center items-center-safe"
          >
            <Icon name="ev71-instructor" size={75} stroke="2" />            
            <span>Instructor</span>
          </button>
        </div>

        {/* Paneles */}
        <div class="login-panels">

          {/* Panel de Login */}
          <div class="login-panel" id="panel-login" role="tabpanel">
            <form id="loginForm" onsubmit="return false">
              <h2>Ingreso <span class="login-role-text">Piloto</span></h2>

              <div class="form-grid">
                <div class="field full">
                  <label for="login-identity">Email o Callsign <span>*</span></label>
                  <input
                    id="login-identity"
                    name="identity"
                    type="text"
                    required
                    placeholder="Tu email o callsign"
                  />
                </div>
                <div class="field full">
                  <label for="login-password">Contraseña <span>*</span></label>
                  <input
                    id="login-password"
                    name="password"
                    type="password"
                    required
                    placeholder="Tu contraseña"
                  />
                </div>
              </div>

              <button class="btn" type="submit">Iniciar sesión</button>
              <a class="form-link" href="#" id="showRecovery">¿Olvidaste tu contraseña?</a>
            </form>
          </div>

          {/* Panel de Recuperación */}
          <div class="login-panel hidden" id="panel-recovery" role="tabpanel">
            <form id="recoveryForm" onsubmit="return false">
              <h2>Recuperar contraseña</h2>

              <div class="form-grid">
                <div class="field full">
                  <label for="recovery-email">Correo electrónico <span>*</span></label>
                  <input
                    id="recovery-email"
                    name="email"
                    type="email"
                    required
                    placeholder="pilot@correo.com"
                  />
                </div>
              </div>

              <button class="btn" type="submit">Enviar enlace de recuperación</button>
              <a class="form-link" href="#" id="showLogin">Volver al inicio de sesión</a>
            </form>
          </div>

        </div>
      </article>

    </section>
  </main>
</BaseLayout>

<script>
  // Tab selector
  const tabs = document.querySelectorAll<HTMLElement>("[role='tab']");
  const roleText = document.querySelector<HTMLElement>(".login-role-text");

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      tabs.forEach((t) => t.setAttribute("aria-selected", "false"));
      tab.setAttribute("aria-selected", "true");

      const role = tab.dataset.tab;
      if (roleText && role) {
        roleText.textContent = role === "piloto" ? "Piloto" : "Instructor";
      }
    });
  });

  // Toggle login ↔ recovery
  const panelLogin = document.getElementById("panel-login");
  const panelRecovery = document.getElementById("panel-recovery");
  const showRecovery = document.getElementById("showRecovery");
  const showLogin = document.getElementById("showLogin");
  const tabsContainer = document.querySelector<HTMLElement>(".login-tabs");

  showRecovery?.addEventListener("click", (e) => {
    e.preventDefault();
    panelLogin?.classList.add("hidden");
    panelRecovery?.classList.remove("hidden");
    tabsContainer?.classList.add("hidden");
  });

  showLogin?.addEventListener("click", (e) => {
    e.preventDefault();
    panelRecovery?.classList.add("hidden");
    panelLogin?.classList.remove("hidden");
    tabsContainer?.classList.remove("hidden");
  });
</script>
