---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { resolvePath, getBase } from "@/lib/base-url";
import '../styles/pages/_sivoe71.scss';

const base = getBase();
---

<BaseLayout
  title="SIVOE-71 | Escuadron 71"
  description="Sistema Integral de Vuelo y Operaciones del Escuadron 71."
>
  <main class="">

    <section class="hero relative overflow-hidden">
      <picture class="absolute top-0 left-0 right-0 bottom-0 w-full h-full z-0">
        <img
          src={`${base}assets/images/ScreenF18.jpg`}
          alt="SIVOE-71 plataforma"
          class="w-full h-full object-cover"
          loading="lazy"
        />
      </picture>
      <div class="container z-1">
        <div class="content">
          <span class="eyebrow">Centro de mando</span>
          <h1>SIVOE-71</h1>
          <p>
            Esta ruta queda reservada para la migracion del sistema SIVOE-71 a Astro.
            Los modulos de operaciones, bitacora, academia y area privada se migraran
            progresivamente desde el HTML legado.
          </p>
          <a class="button" href={resolvePath("/")}>Volver al inicio</a>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>
