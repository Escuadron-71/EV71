---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getBase, resolvePath } from "@/lib/base-url";
import NewsItem from "@/components/blog/NewsItem.astro";
import { multimediaService } from "@/lib/services/multimedia-service";
import "../styles/pages/_blog.scss";

const news = multimediaService.getNews();
const base = getBase();
const heroImage = `${base}assets/images/ScreenF18.jpg`;
---

<BaseLayout
  title="Noticias | Escuadrón 71"
  description="Noticias del Escuadrón 71: novedades, misiones y anuncios oficiales de la comunidad."
>
  <main role="main">
    <section class="blog-hero hero relative overflow-hidden">
      <picture class="absolute top-0 left-0 right-0 bottom-0 w-full h-full z-0">
        <img
          src={heroImage}
          alt="Aeronaves del Escuadrón 71 en formación"
          class="w-full h-full object-cover"
          loading="eager"
        />
      </picture>
      <div
        class="blog-hero__overlay absolute top-0 left-0 right-0 bottom-0 z-0"
        aria-hidden="true"
      ></div>
      <div class="container z-1">
        <div class="blog-hero__content">
          <span class="blog-eyebrow">Novedades del escuadrón</span>
          <h1 class="blog-hero__title">Noticias</h1>
          <p class="blog-hero__description">
            Novedades, misiones y anuncios oficiales de la comunidad.
          </p>
        </div>
      </div>
    </section>

    <section class="section blog-section" aria-labelledby="noticias-titulo">
      <div class="container">
        <span class="blog-eyebrow">Contenido de ejemplo</span>
        <h2 id="noticias-titulo" class="blog-section-title">
          Últimas noticias
        </h2>
        <p class="blog-note">
          Estas notas son contenido de ejemplo para validar la estructura. El
          contenido real llegará desde el pipeline de sincronización cuando se
          active.
        </p>
        <div class="news-timeline">
          {news.map((item) => (
            <NewsItem item={item} />
          ))}
        </div>
        <a class="blog-back" href={resolvePath("/multimedia?tab=noticias")}>
          Ver tab de Noticias en Multimedia
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
