---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getBase, resolvePath } from "@/lib/base-url";
import AircraftCard from "@/components/fleet/AircraftCard.astro";
import type { Aircraft, AircraftRole, FleetData } from "@/types/fleet";
import { ROLE_LABELS } from "@/types/fleet";
import fleetData from "@/data/fleet/aircraft.json";
import "../styles/pages/_fleet.scss";

const { note, aircraft } = fleetData as FleetData;
const base = getBase();
const heroImage = `${base}assets/images/ScreenF18.jpg`;

const roleOrder: AircraftRole[] = ["caza", "ataque", "transporte", "helo"];
const grouped = roleOrder
  .map((role) => ({
    role,
    items: aircraft.filter((a) => a.rol === role),
  }))
  .filter((group) => group.items.length > 0);
---

<BaseLayout
  title="Flota | Escuadrón 71"
  description="Flota de aeronaves del Escuadrón 71 en DCS World: cazas, ataque y apoyo con ficha técnica y pilotos."
>
  <main role="main">
    <section class="fleet-hero hero relative overflow-hidden">
      <picture class="absolute top-0 left-0 right-0 bottom-0 w-full h-full z-0">
        <img
          src={heroImage}
          alt="Aeronave del Escuadrón 71 en vuelo"
          class="w-full h-full object-cover"
          loading="eager"
        />
      </picture>
      <div
        class="fleet-hero__overlay absolute top-0 left-0 right-0 bottom-0 z-0"
        aria-hidden="true"
      ></div>
      <div class="container z-1">
        <div class="fleet-hero__content">
          <span class="fleet-eyebrow">Catálogo de aeronaves</span>
          <h1 class="fleet-hero__title">Flota</h1>
          <p class="fleet-hero__description">
            Las aeronaves operadas por el Escuadrón 71 en DCS World, con ficha
            técnica, rol táctico y los pilotos que las operan.
          </p>
        </div>
      </div>
    </section>

    <section class="section fleet-section" aria-labelledby="flota-titulo">
      <div class="container">
        <span class="fleet-eyebrow">Operadas por el escuadrón</span>
        <h2 id="flota-titulo" class="fleet-section-title">
          Nuestra flota
        </h2>
        <p class="fleet-note">{note}</p>

        {grouped.map((group) => (
          <section class="fleet-group" aria-label={ROLE_LABELS[group.role]}>
            <h3 class="fleet-group__title">{ROLE_LABELS[group.role]}</h3>
            <div class="fleet-grid">
              {group.items.map((item: Aircraft) => (
                <AircraftCard aircraft={item} />
              ))}
            </div>
          </section>
        ))}

        <div class="fleet-cta">
          <a href={resolvePath("/academia/avva71")}>
            Entrena con nuestra flota en la Academia
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
