---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { resolvePath } from "@/lib/base-url";
import { EventService } from "@/lib/services/event-service";
import '../styles/pages/_home.scss';

const base = resolvePath("/");

const eventService = new EventService();
const nextEvent = await eventService.getNextEvent();

const formatFeaturedDate = (dateStr: string) => {
  const d = new Date(dateStr);
  const day = d.getDate().toString().padStart(2, "0");
  const month = d.toLocaleDateString("es-ES", { month: "short" }).toUpperCase();
  const year = d.getFullYear();
  const hours = d.getHours().toString().padStart(2, "0");
  const minutes = d.getMinutes().toString().padStart(2, "0");
  return { date: `${day} ${month} ${year}`, time: `${hours}:${minutes}` };
};

const fmtCal = (d: Date) =>
  d.getUTCFullYear().toString().padStart(4, "0") +
  (d.getUTCMonth() + 1).toString().padStart(2, "0") +
  d.getUTCDate().toString().padStart(2, "0") + "T" +
  d.getUTCHours().toString().padStart(2, "0") +
  d.getUTCMinutes().toString().padStart(2, "0") +
  "00Z";

const nosotrosCards = [
  {
    image: "https://d1ldvf68ux039x.cloudfront.net/thumbs/photos/0711/64625/1000w_q95.jpg",
    alt: "Pilotos de la comunidad en formacion",
    title: "Entrenamiento",
    text: "FR1, Teoria y Practica, Principios basicos de aviacion militar, navegacion, maniobras, etc. en el Avion de entrenamiento T-45 Goshawk"
  },
  {
    image: `${base}assets/images/entrenamiento.png`,
    alt: "Operaciones de entrenamiento en DCS",
    title: "Operaciones",
    text: "Misiones cooperativas dinamicas con planificacion militar y roles especializados. CAP, CAS, SEAD, CSAR."
  },
  {
    image: `${base}assets/images/ScreenF18.jpg`,
    alt: "Imagen screenf18 de la comunidad",
    title: "Comunidad",
    text: "Una comunidad virtual de pilotos virtuales en un entorno organizado, competitivo y colaborativo para pilotos de toda Latinoamerica."
  }
];

const fleet = [
  { name: "F/A-18C Hornet", image: `${base}assets/images/ScreenF18.jpg`, text: "Superioridad aerea, interdiccion naval y capacidad multirole en DCS." },
  { name: "F-16C Viper", image: `${base}assets/images/F16.png`, text: "Combate aire-aire, SEAD y apoyo tactico moderno." },
  { name: "F-14 Tomcat", image: `${base}assets/images/F14.jpg`, text: "Intercepcion de largo alcance, superioridad aerea y operaciones embarcadas." },
  { name: "A-10C II Tank Killer", image: `${base}assets/images/A10.jpg`, text: "Close Air Support con potencia de destruccion contra blindados." },
  { name: "UH-60 Black Hawk", image: `${base}assets/images/UH60.jpg`, text: "Insercion de tropas, CSAR y operaciones helitransportadas." },
  { name: "AH-64D Apache", image: `${base}assets/images/APACHE.jpg`, text: "Apoyo de fuego, reconocimiento armado y ataque antitanque." },
  { name: "UH-1H Huey", image: `${base}assets/images/HUEY.png`, text: "Transporte utilitario, evacuacion medica y apoyo aereo ligero." }
];

const gallery = [
  { src: `${base}assets/images/ScreenF18.jpg`, alt: "Escuadron 71 web" },
  { src: `${base}assets/images/Screen_260217_194224.jpg`, alt: "Escuadron 71 YouTube" },
  { src: `${base}assets/images/Screen_260523_235322.jpg`, alt: "Escuadron 71 Instagram" },
  { src: `${base}assets/images/DCS1.png`, alt: "Escuadron 71 DCS" }
];
---

<BaseLayout
  title="Escuadron 71 | Simulacion Aerea Militar DCS World"
  description="Escuadron virtual latinoamericano dedicado al entrenamiento tactico y operaciones conjuntas en DCS World."
>

  <main>
    {/* Hero */}
    <section class="pt-0! hero relative" id="inicio">
      <picture class="absolute top-0 left-0 right-0 bottom-0 w-full h-full z-0">
        <img
          src={`${base}assets/images/Banner1.jpg`}
          alt="Escuadron 71 en operacion"
          class="inset-0 w-full h-full object-cover"
          loading="eager"
        />
      </picture>
      <div class="container z-1">
        <div class="hero-content">
          <h1>Escuadron 71</h1>
          <p>
            Bienvenido al Escuadron 71 — Comunidad de vuelo virtual en DCS dedicada a la
            simulacion aerea, el entrenamiento tactico y la camaraderia.
          </p>
          <div class="hero-actions">
            <a class="btn" href={resolvePath("/postulacion")}>Unete al escuadron</a>
            <a class="button button-secondary" href={resolvePath("/sivoe71")}>SIVOE-71</a>
          </div>
        </div>
      </div>
    </section>

    {/* Nosotros */}
    <section class="section" id="nosotros">
      <div class="container">
        <div class="section-title" style="text-align:center; margin-bottom:60px;">
          <h2>Quienes Somos?</h2>
          <p style="color:var(--color-text-muted); max-width:800px; margin:auto; font-size:1.2rem;">
            El Escuadron 71 es una comunidad de aviadores virtuales dedicada a la simulacion aerea avanzada dentro de DCS World. Nuestro proposito es desarrollar pilotos altamente capacitados mediante entrenamiento estructurado, procedimientos estandarizados y operaciones coordinadas que reproduzcan de manera realista el entorno de combate aereo moderno.
          </p>
        </div>

        <div class="card-grid nosotros-grid">
          {nosotrosCards.map((card) => (
            <article class="card">
              <img src={card.image} alt={card.alt} loading="lazy" />
              <div class="card-content">
                <h3>{card.title}</h3>
                <p>{card.text}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    {/* Flota */}
    <section class="section" id="flota">
      <div class="container">
        <div class="section-heading">
          <span class="eyebrow">Flota</span>
          <h2>Nuestra Flota</h2>
        </div>

        <div class="card-grid">
          {fleet.map((aircraft) => (
            <article class="card">
              <img src={aircraft.image} alt={aircraft.name} loading="lazy" />
              <div class="card-content">
                <h3>{aircraft.name}</h3>
                <p>{aircraft.text}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    {/* Operaciones */}
    <section class="operation-band hero relative overflow-hidden" id="operaciones">
      <picture class="absolute top-0 left-0 right-0 bottom-0 w-full h-full z-0!">
        <img
          src={`${base}assets/images/DCS1.png`}
          alt="Operaciones del Escuadron 71"
          class="absolute inset-0 w-full h-full object-cover"
          loading="lazy"
        />
      </picture>
      <div class="container flex flex-col justify-start items-center z-1">
        <div class="section-heading">
          <span class="eyebrow">Operaciones</span>
          <h2>Proximas Operaciones</h2>
        </div>

        {nextEvent ? (
          <div class="operation-panel featured-event w-full">
            <div class="featured-event__badge">PROXIMA OPERACION</div>
            <div class="featured-event__flex">
              {nextEvent.image && (
                <img
                  src={resolvePath(nextEvent.image)}
                  alt={nextEvent.title}
                  class="featured-event__image"
                  loading="lazy"
                />
              )}
              <div class="featured-event__body">
                <div class="featured-event__meta">
                  <span class="featured-event__date">
                    {formatFeaturedDate(nextEvent.startDate).date}
                  </span>
                  <span class="featured-event__time">
                    {formatFeaturedDate(nextEvent.startDate).time} HRS
                  </span>
                </div>
                <h3 class="featured-event__title">{nextEvent.title}</h3>
                {nextEvent.description && (
                  <div class="featured-event__desc-wrap">
                    <input type="checkbox" class="featured-event__toggle" id={`feat-desc-${nextEvent.id}`} hidden />
                    <p class="featured-event__desc">{nextEvent.description}</p>
                    <label class="featured-event__toggle-label" for={`feat-desc-${nextEvent.id}`}>
                      <span class="featured-event__toggle-more">Leer m&aacute;s</span>
                      <span class="featured-event__toggle-less">Mostrar menos</span>
                    </label>
                  </div>
                )}
                <div class="featured-event__actions">
                  {nextEvent.eventUrl && (
                    <a
                      href={nextEvent.eventUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="featured-event__btn"
                    >
                      Participar
                    </a>
                  )}
                  {nextEvent.interestedCount !== undefined && (
                    <span class="featured-event__interested">
                      <span class="featured-event__dot"></span>
                      {nextEvent.interestedCount} interesados
                    </span>
                  )}
                  <a
                    href={`https://www.google.com/calendar/render?${new URLSearchParams({
                      action: "TEMPLATE",
                      text: nextEvent.title,
                      dates: `${fmtCal(new Date(nextEvent.startDate))}/${nextEvent.endDate ? fmtCal(new Date(nextEvent.endDate)) : fmtCal(new Date(nextEvent.startDate))}`,
                      details: nextEvent.description || "",
                      location: nextEvent.location || "",
                      ctz: "UTC",
                    }).toString()}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="featured-event__btn featured-event__btn--outline"
                  >
                    Calendar
                  </a>
                  <a
                    href={resolvePath("/operaciones")}
                    class="featured-event__cta"
                  >
                    Ver todas &rarr;
                  </a>
                </div>
              </div>
            </div>
          </div>
        ) : (
          <div class="operation-panel w-full">
            <p class="event-empty">
              No hay operaciones programadas en este momento.
            </p>
          </div>
        )}
      </div>
    </section>

    {/* Unete */}
    <section class="join-section" id="unete">
      <div class="container">
        <h2>Unete al Escuadron 71</h2>
        <p>
          Entrenamiento realista · Operaciones conjuntas · Comunidad de Pilotos Virtuales
        </p>
        <a class="btn" href={resolvePath("/postulacion")}>Aplicar Ahora</a>
      </div>
    </section>

    {/* Galeria */}
    <section class="section" id="galeria">
      <div class="container">
        <div class="section-heading">
          <span class="eyebrow">Galeria</span>
          <h2>Galeria de Vuelo</h2>
        </div>
        <div class="gallery-grid">
          {gallery.map((image) => (
            <img src={image.src} alt={image.alt} loading="lazy" />
          ))}
        </div>
      </div>
    </section>
  </main>

</BaseLayout>
