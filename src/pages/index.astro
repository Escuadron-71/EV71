---
import BaseLayout from "@/layouts/BaseLayout.astro";

const nosotrosCards = [
  {
    image: "https://d1ldvf68ux039x.cloudfront.net/thumbs/photos/0711/64625/1000w_q95.jpg",
    alt: "Pilotos de la comunidad en formacion",
    title: "Entrenamiento",
    text: "FR1, Teoria y Practica, Principios basicos de aviacion militar, navegacion, maniobras, etc. en el Avion de entrenamiento T-45 Goshawk"
  },
  {
    image: "/assets/images/entrenamiento.png",
    alt: "Operaciones de entrenamiento en DCS",
    title: "Operaciones",
    text: "Misiones cooperativas dinamicas con planificacion militar y roles especializados. CAP, CAS, SEAD, CSAR."
  },
  {
    image: "/assets/images/ScreenF18.jpg",
    alt: "Imagen screenf18 de la comunidad",
    title: "Comunidad",
    text: "Una comunidad virtual de pilotos virtuales en un entorno organizado, competitivo y colaborativo para pilotos de toda Latinoamerica."
  }
];

const fleet = [
  { name: "F/A-18C Hornet", image: "/assets/images/ScreenF18.jpg", text: "Superioridad aerea, interdiccion naval y capacidad multirole en DCS." },
  { name: "F-16C Viper", image: "/assets/images/F16.png", text: "Combate aire-aire, SEAD y apoyo tactico moderno." },
  { name: "F-14 Tomcat", image: "/assets/images/F14.jpg", text: "Intercepcion de largo alcance, superioridad aerea y operaciones embarcadas." },
  { name: "A-10C II Tank Killer", image: "/assets/images/A10.jpg", text: "Close Air Support con potencia de destruccion contra blindados." },
  { name: "UH-60 Black Hawk", image: "/assets/images/UH60.jpg", text: "Insercion de tropas, CSAR y operaciones helitransportadas." },
  { name: "AH-64D Apache", image: "/assets/images/APACHE.jpg", text: "Apoyo de fuego, reconocimiento armado y ataque antitanque." },
  { name: "UH-1H Huey", image: "/assets/images/HUEY.png", text: "Transporte utilitario, evacuacion medica y apoyo aereo ligero." }
];

const gallery = [
  { src: "/assets/images/ScreenF18.jpg", alt: "Escuadron 71 web" },
  { src: "/assets/images/Screen_260217_194224.jpg", alt: "Escuadron 71 YouTube" },
  { src: "/assets/images/Screen_260523_235322.jpg", alt: "Escuadron 71 Instagram" },
  { src: "/assets/images/DCS1.png", alt: "Escuadron 71 DCS" }
];
---

<BaseLayout
  title="Escuadron 71 | Simulacion Aerea Militar DCS World"
  description="Escuadron virtual latinoamericano dedicado al entrenamiento tactico y operaciones conjuntas en DCS World."
>

  <main>
    {/* Hero */}
    <section class="hero" id="inicio">
      <div class="container">
        <div class="hero-content">
          <h1>Escuadron 71</h1>
          <p>
            Bienvenido al Escuadron 71 — Comunidad de vuelo virtual en DCS dedicada a la
            simulacion aerea, el entrenamiento tactico y la camaraderia.
          </p>
          <div class="hero-actions">
            <a class="btn" href="/postulacion">Unete al escuadron</a>
            <a class="button button-secondary" href="/sivoe71">SIVOE-71</a>
          </div>
        </div>
      </div>
    </section>

    {/* Nosotros */}
    <section class="section" id="nosotros">
      <div class="container">
        <div class="section-title" style="text-align:center; margin-bottom:60px;">
          <h2>Quienes Somos?</h2>
          <p style="color:var(--color-text-muted); max-width:800px; margin:auto; font-size:1.2rem;">
            El Escuadron 71 es una comunidad de aviadores virtuales dedicada a la simulacion aerea avanzada dentro de DCS World. Nuestro proposito es desarrollar pilotos altamente capacitados mediante entrenamiento estructurado, procedimientos estandarizados y operaciones coordinadas que reproduzcan de manera realista el entorno de combate aereo moderno.
          </p>
        </div>

        <div class="card-grid nosotros-grid">
          {nosotrosCards.map((card) => (
            <article class="card">
              <img src={card.image} alt={card.alt} loading="lazy" />
              <div class="card-content">
                <h3>{card.title}</h3>
                <p>{card.text}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    {/* Flota */}
    <section class="section" id="flota">
      <div class="container">
        <div class="section-heading">
          <span class="eyebrow">Flota</span>
          <h2>Nuestra Flota</h2>
        </div>

        <div class="card-grid">
          {fleet.map((aircraft) => (
            <article class="card">
              <img src={aircraft.image} alt={aircraft.name} loading="lazy" />
              <div class="card-content">
                <h3>{aircraft.name}</h3>
                <p>{aircraft.text}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    {/* Operaciones */}
    <section class="operation-band" id="operaciones">
      <div class="container">
        <div class="section-heading">
          <span class="eyebrow">Operaciones</span>
          <h2>Proximas Operaciones</h2>
        </div>
        <div class="operation-panel">
          <h3>Calendario Operacional</h3>
          <ul>
            <li>
              <strong>Entrenamiento FR1 y CR1</strong>
              <span>Todos los dias (programado 1700Hr - 7:00Pm)</span>
            </li>
            <li>
              <strong>Operacion "Demonio Negro"</strong>
              <span>Proximamente - Preparate</span>
            </li>
          </ul>
        </div>
      </div>
    </section>

    {/* Unete */}
    <section class="join-section" id="unete">
      <div class="container">
        <h2>Unete al Escuadron 71</h2>
        <p>
          Entrenamiento realista · Operaciones conjuntas · Comunidad de Pilotos Virtuales
        </p>
        <a class="btn" href="/postulacion">Aplicar Ahora</a>
      </div>
    </section>

    {/* Galeria */}
    <section class="section" id="galeria">
      <div class="container">
        <div class="section-heading">
          <span class="eyebrow">Galeria</span>
          <h2>Galeria de Vuelo</h2>
        </div>
        <div class="gallery-grid">
          {gallery.map((image) => (
            <img src={image.src} alt={image.alt} loading="lazy" />
          ))}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>


