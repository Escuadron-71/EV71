---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { resolvePath } from "@/lib/base-url";
import "../../styles/pages/_stub.scss";
---

<BaseLayout
  title="AVVA71 | Academia | Escuadrón 71"
  description="Escuela de Vuelo Virtual AVVA71: formación aeronáutica para pilotos del Escuadrón 71."
>
  <main class="stub-page" role="main">
    <div class="stub-panel">
      <span class="stub-eyebrow">En construcción</span>
      <h1 class="stub-title">AVVA71</h1>
      <p class="stub-description">
        Escuela de Vuelo Virtual AVVA71. Próximamente: programa de formación,
        temario y requisitos de ingreso.
      </p>
      <a class="stub-back" href={resolvePath("/")}>Regresar al inicio</a>
    </div>
  </main>
</BaseLayout>
