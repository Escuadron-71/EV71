---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { resolvePath } from "@/lib/base-url";
import "../../styles/pages/_stub.scss";
---

<BaseLayout
  title="Curso Básico FR1 | Academia | Escuadrón 71"
  description="Curso Básico FR1: introducción al vuelo y procedimientos básicos para aspirantes del Escuadrón 71."
>
  <main class="stub-page" role="main">
    <div class="stub-panel">
      <span class="stub-eyebrow">En construcción</span>
      <h1 class="stub-title">Curso Básico FR1</h1>
      <p class="stub-description">
        Curso Básico FR1. Próximamente: temario, plan de vuelo y evaluaciones
        del curso inicial de la academia.
      </p>
      <a class="stub-back" href={resolvePath("/")}>Regresar al inicio</a>
    </div>
  </main>
</BaseLayout>
