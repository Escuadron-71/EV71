---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { resolvePath } from "@/lib/base-url";
import "../../styles/pages/_stub.scss";
---

<BaseLayout
  title="Curso Avanzado CR2 | Academia | Escuadrón 71"
  description="Curso Avanzado CR2: combate aéreo táctico y sistemas de armas avanzados para pilotos del Escuadrón 71."
>
  <main class="stub-page" role="main">
    <div class="stub-panel">
      <span class="stub-eyebrow">En construcción</span>
      <h1 class="stub-title">Curso Avanzado CR2</h1>
      <p class="stub-description">
        Curso Avanzado CR2. Próximamente: temario, plan de vuelo y evaluaciones
        del curso de combate aéreo táctico de la academia.
      </p>
      <a class="stub-back" href={resolvePath("/")}>Regresar al inicio</a>
    </div>
  </main>
</BaseLayout>
