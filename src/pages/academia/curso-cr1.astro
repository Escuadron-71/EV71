---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { resolvePath } from "@/lib/base-url";
import "../../styles/pages/_stub.scss";
---

<BaseLayout
  title="Curso Básico CR1 | Academia | Escuadrón 71"
  description="Curso Básico CR1: caza reactiva y maniobras básicas de combate para pilotos del Escuadrón 71."
>
  <main class="stub-page" role="main">
    <div class="stub-panel">
      <span class="stub-eyebrow">En construcción</span>
      <h1 class="stub-title">Curso Básico CR1</h1>
      <p class="stub-description">
        Curso Básico CR1. Próximamente: temario, plan de vuelo y evaluaciones
        del curso de caza reactiva de la academia.
      </p>
      <a class="stub-back" href={resolvePath("/")}>Regresar al inicio</a>
    </div>
  </main>
</BaseLayout>
