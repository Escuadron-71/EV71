---
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Escuadron 71, comunidad latinoamericana de simulacion aerea militar en DCS World."
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Rajdhani:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --color-bg: #0c1117;
    --color-panel: #111821;
    --color-panel-strong: #070b10;
    --color-accent: #ff7a00;
    --color-accent-soft: rgba(255, 122, 0, 0.16);
    --color-gold: #c8a44d;
    --color-text: #f5f5f5;
    --color-muted: #b7b7b7;
    --color-border: rgba(255, 255, 255, 0.08);
    --shadow-panel: 0 14px 35px rgba(0, 0, 0, 0.42);
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    min-height: 100vh;
    font-family: "Rajdhani", sans-serif;
    color: var(--color-text);
    background: linear-gradient(to bottom, #0a0f14, #111821);
    overflow-x: hidden;
  }

  img {
    max-width: 100%;
    display: block;
  }

  a {
    color: inherit;
  }

  .container {
    width: min(92%, 1400px);
    margin-inline: auto;
  }
</style>
