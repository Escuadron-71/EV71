---
import type { Product } from "@/types/store";
import { resolvePath } from "@/lib/base-url";
import { formatPrice } from "@/lib/store/whatsapp";

interface Props {
  product: Product;
}

const { product } = Astro.props;
const href = resolvePath(`/tienda/${product.slug}`);
const stockLabel = product.disponible ? "Disponible" : "Agotado";
---

<article class="product-card">
  <a href={href} class="product-card__link">
    <div class="product-card__media">
      <img
        src={resolvePath(product.imagen)}
        alt={product.nombre}
        class="product-card__image"
        loading="lazy"
      />
      <span
        class={`product-card__status ${product.disponible ? "is-available" : "is-out"}`}
      >
        {stockLabel}
      </span>
    </div>
    <div class="product-card__body">
      <span class="product-card__category">{product.categoria}</span>
      <h2 class="product-card__name">{product.nombre}</h2>
      <p class="product-card__price">
        {formatPrice(product.precio, product.moneda)}
      </p>
      <span class="product-card__cta">Ver producto</span>
    </div>
  </a>
</article>
