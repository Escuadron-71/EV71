---
import type { Product } from "@/types/store";
import { resolvePath } from "@/lib/base-url";
import { formatPrice, descuentoPct } from "@/lib/store/whatsapp";

interface Props {
  product: Product;
}

const { product } = Astro.props;
const href = resolvePath(`/tienda/${product.slug}`);
const stockLabel = product.disponible ? "Disponible" : "Agotado";
const discount = descuentoPct(product);
const hasPrevious =
  product.precioAnterior !== undefined && product.precioAnterior > product.precio;
const searchHaystack = [
  product.nombre,
  product.descripcion,
  product.categoria,
  ...product.especificaciones.map((s) => s.value),
]
  .join(" ")
  .toLowerCase();
---

<article
  class="product-card"
  data-product
  data-categoria={product.categoria}
  data-nombre={product.nombre}
  data-precio={product.precio}
  data-nuevo={product.nuevo ? "true" : ""}
  data-descuento={discount ?? ""}
  data-search={searchHaystack}
>
  <a href={href} class="product-card__link">
    <div class="product-card__media">
      <img
        src={resolvePath(product.imagen)}
        alt={product.nombre}
        class="product-card__image"
        loading="lazy"
      />
      <div class="product-card__badges">
        {product.nuevo && <span class="product-card__badge is-new">Nuevo</span>}
        {discount !== null && (
          <span class="product-card__badge is-off">-{discount}%</span>
        )}
        <span
          class={`product-card__status ${product.disponible ? "is-available" : "is-out"}`}
        >
          {stockLabel}
        </span>
      </div>
    </div>
    <div class="product-card__body">
      <span class="product-card__category">{product.categoria}</span>
      <h2 class="product-card__name">{product.nombre}</h2>
      <p class="product-card__price">
        {hasPrevious && (
          <s class="product-card__price-old">
            {formatPrice(product.precioAnterior!, product.moneda)}
          </s>
        )}
        {formatPrice(product.precio, product.moneda)}
      </p>
      <span class="product-card__cta">Ver producto</span>
    </div>
  </a>
</article>
