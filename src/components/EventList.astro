---
import EventCard from "./EventCard.astro";
import type { ServiceEvent } from "@/lib/services/event-service";

interface Props {
  events: ServiceEvent[];
}

const { events } = Astro.props;
---

{events.length > 0 ? (
  <div class="event-grid">
    {events.map((event) => <EventCard event={event} />)}
  </div>
) : (
  <div class="event-empty">
    <p>No hay operaciones programadas en este momento.</p>
  </div>
)}
