---
import Icon from "@/components/UI/Icon.astro";

const socialLinks = [
  { href: "https://www.youtube.com/@dcsescuadron71", label: "YouTube", icon: "logoyoutube" },
  { href: "https://discord.gg/pMbvD3KwV", label: "Discord", icon: "logodiscord" },
  { href: "https://www.instagram.com/dcs_escuadron_71", label: "Instagram", icon: "logoinstagram" },
  { href: "https://www.facebook.com/DCSEscuadron71deColombia", label: "Facebook", icon: "logofacebook" },
  { href: "https://www.tiktok.com/@escuadron71?is_from_webapp=1&sender_device=pc", label: "TikTok", icon: "logotiktok" },
  { href: "https://www.twitter.com/Scuadron71", label: "X", icon: "logox" },
  { href: "https://www.patreon.com/Escuadron71", label: "Patreon", icon: "logopatreon" }
];
---

<footer class="site-footer" id="contacto">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-box">
        <h3>Escuadron 71</h3>
        <p>Comunidad de simulacion aerea militar especializada en DCS World.</p>
      </div>

      <div class="footer-box">
        <h3>Contacto</h3>
        <p>
          Email: <a class="contact-email" href="mailto:dcsescuadron71@gmail.com">dcsescuadron71@gmail.com</a>
        </p>
      </div>

      <div class="footer-box">
        <h3>Redes</h3>
        <div class="social-links" aria-label="Redes sociales">
          {socialLinks.map((link) => (
            <a class="social-icon" href={link.href} target="_blank" rel="noopener noreferrer" title={link.label} aria-label={link.label}>
              <Icon name={link.icon} size={34} />
            </a>
          ))}
        </div>
      </div>
    </div>

    <div class="copyright">
      &copy; 2026 Escuadron 71 - Todos los derechos reservados.
    </div>
  </div>
</footer>
