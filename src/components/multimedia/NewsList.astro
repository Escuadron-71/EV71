---
interface Item {
  id: string;
  title: string;
  date: string;
  summary: string;
  url: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<ul class="news-list" data-list>
  {items.map((item) => (
    <li class="news-item" data-search={`${item.title} ${item.summary}`.toLowerCase()} data-card>
      <a href={item.url} class="news-item-link">
        <time class="news-item-date">{item.date}</time>
        <span class="news-item-body">
          <span class="news-item-title">{item.title}</span>
          <span class="news-item-summary">{item.summary}</span>
        </span>
      </a>
    </li>
  ))}
</ul>
