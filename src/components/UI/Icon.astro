---
interface Props {
  name: string;
  size?: number;
  class?: string;
  fill?: string;
  stroke?: string;
  label?: string;
  href?: string;
  target?: string;
  rel?: string;
}

const {
  name,
  size = 24,
  class: className = "",
  fill,
  stroke,
  label,
  href,
  target,
  rel,
} = Astro.props;

// Cargar todos los SVGs en build time via Vite (sin dependencias Node.js)
const svgModules = import.meta.glob("/src/assets/icons/*.svg", {
  query: "?raw",
  import: "default",
  eager: true,
});

// Construir mapa nombre → contenido SVG
const icons: Record<string, string> = {};
for (const [key, value] of Object.entries(svgModules)) {
  const fileName = key.split("/").pop() ?? "";
  const iconName = fileName.replace(".svg", "");
  icons[iconName] = value as string;
}

// Normalizar nombre: aceptar con o sin extension
const lookupName = name.endsWith(".svg") ? name.replace(".svg", "") : name;

// Obtener contenido SVG
let svgContent = icons[lookupName] ?? "";
if (!svgContent) {
  console.error(`[Icon] No se encontro el icono: "${lookupName}"`);
}

// Limpiar atributos del SVG original para no conflictuar
svgContent = svgContent
  .replace(/\s*width="[^"]*"/, "")
  .replace(/\s*height="[^"]*"/, "")
  .replace(/\s*class="[^"]*"/, "");

// Inyectar tamaño en el tag <svg>
svgContent = svgContent.replace(
  /<svg\b/,
  `<svg width="${size}" height="${size}"`
);

// Inyectar fill si se provee
if (fill !== undefined) {
  svgContent = svgContent.replace(
    /<svg\b([^>]*)>/,
    (_match, attrs: string) => {
      const cleaned = attrs.replace(/\s*fill="[^"]*"/, "");
      return `<svg${cleaned} fill="${fill}">`;
    }
  );
}

// Inyectar stroke si se provee
if (stroke !== undefined) {
  svgContent = svgContent.replace(
    /<svg\b([^>]*)>/,
    (_match, attrs: string) => {
      const cleaned = attrs.replace(/\s*stroke="[^"]*"/, "");
      return `<svg${cleaned} stroke="${stroke}">`;
    }
  );
}

// Inyectar aria-label si se provee
if (label) {
  svgContent = svgContent.replace(
    /<svg\b/,
    `<svg role="img" aria-label="${label}"`
  );
}

// Agregar clase adicional al <svg> si se provee
if (className) {
  svgContent = svgContent.replace(/<svg\b/, `<svg class="${className}"`);
}
---

{href ? (
  <a
    href={href}
    target={target || "_self"}
    rel={rel}
    class="icon-link"
  >
    <Fragment set:html={svgContent} />
  </a>
) : (
  <Fragment set:html={svgContent} />
)}
