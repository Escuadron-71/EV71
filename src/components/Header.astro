---
import UserDropdown from "@/islands/UserDropdown.tsx";
import { resolvePath, getBase } from "@/lib/base-url";

const norm = (p: string) => p.replace(/\/+$/, "") || "/";
const routeOf = (href: string) => norm("/" + href.replace(getBase(), ""));
const isCurrent = (href: string) => routeOf(href) === norm(Astro.url.pathname);

const svgModules = import.meta.glob("/src/assets/icons/*.svg", {
  query: "?raw",
  import: "default",
  eager: true,
});

let userIconSvg = "";
for (const [key, value] of Object.entries(svgModules)) {
  if (key.includes("ev71-user")) {
    userIconSvg = (value as string)
      .replace(/\s*class="[^"]*"/, "")
      .replace(/<svg\b/, '<svg width="24" height="24" fill="var(--color-secondary)"');
    break;
  }
}

const navItems = [
  { label: "Inicio", href: resolvePath("/"), active: isCurrent(resolvePath("/")) },
  { label: "Operaciones", href: resolvePath("/operaciones"), active: isCurrent(resolvePath("/operaciones")) },
  { label: "Galeria", href: resolvePath("/#galeria") },
];

const nosotrosItems = [
  { label: "Quiénes somos", href: resolvePath("/#nosotros") },
  { separator: true as const },
  { label: "Misión y Visión", href: resolvePath("/nosotros/mision-vision") },
  { label: "Declaración", href: resolvePath("/nosotros/declaracion") },
  { label: "Objetivos", href: resolvePath("/nosotros/objetivos") },
  { label: "Reglamento", href: resolvePath("/nosotros/reglamento") },
  { label: "Historia", href: resolvePath("/nosotros/historia") },
  { label: "Estructura", href: resolvePath("/nosotros/estructura") },
];

const academiaItems = [
  { label: "Flota", href: resolvePath("/#flota") },
  { separator: true as const },
  { label: "Ingreso / Login", href: resolvePath("/login") },
];

const actividadItems = [
  { label: "Dogfight", href: resolvePath("/dogfight") },
];

const userItems = [
  { label: "Idioma", href: resolvePath("/#") },
  { separator: true as const },
  { label: "Iniciar sesión", href: resolvePath("/login") },
  { label: "Cerrar sesión", href: resolvePath("/#") },
];
---

<header class="site-header">
  <div class="header-inner">
    <a href={resolvePath("/")} class="brand">
      <div class="brand-logo">
        <img src={`${resolvePath("/")}assets/images/logo.png`} alt="Escudo EV71" />
      </div>
      <div class="brand-text">
        <span class="brand-name">ESCUADRÓN <strong>71</strong></span>
        <span class="brand-sub">Comunidad de aviación virtual</span>
      </div>
    </a>

    <nav class="main-nav" id="menu" aria-label="Navegacion principal">
      {navItems.map((item) => (
        <a href={item.href} class:list={[{ active: item.active }]}>{item.label}</a>
      ))}

      <div class="nav-dropdown" data-nav-dropdown>
        <button class="nav-dropdown-trigger" data-nav-dropdown-trigger aria-haspopup="true" aria-expanded="false">
          Nosotros
          <svg class="chevron" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M1 1l4 4 4-4" />
          </svg>
        </button>
        <div class="nav-dropdown-panel dropdown-panel" role="menu" aria-label="Nosotros">
          {nosotrosItems.map((item) => {
            if (item.separator) {
              return <div class="dropdown-separator" role="separator" />;
            }
            return (
              <a href={item.href} class="dropdown-item" role="menuitem">
                {item.label}
              </a>
            );
          })}
        </div>
      </div>

      <div class="nav-dropdown" data-nav-dropdown>
        <button class="nav-dropdown-trigger" data-nav-dropdown-trigger aria-haspopup="true" aria-expanded="false">
          Academia
          <svg class="chevron" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M1 1l4 4 4-4" />
          </svg>
        </button>
        <div class="nav-dropdown-panel dropdown-panel" role="menu" aria-label="Academia">
          {academiaItems.map((item) => {
            if (item.separator) {
              return <div class="dropdown-separator" role="separator" />;
            }
            return (
              <a href={item.href} class="dropdown-item" role="menuitem">
                {item.label}
              </a>
            );
          })}
        </div>
      </div>

      <div class="nav-dropdown" data-nav-dropdown>
        <button class="nav-dropdown-trigger" data-nav-dropdown-trigger aria-haspopup="true" aria-expanded="false">
          Actividades
          <svg class="chevron" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M1 1l4 4 4-4" />
          </svg>
        </button>
        <div class="nav-dropdown-panel dropdown-panel" role="menu" aria-label="Actividades">
          {actividadItems.map((item) => (
            <a href={item.href} class="dropdown-item" role="menuitem">
              {item.label}
            </a>
          ))}
        </div>
      </div>
    </nav>

    <div class="profile flex items-center gap-2">
      <a href={resolvePath("/postulacion")} class="header-cta">
        POSTÚLATE
      </a>

      <UserDropdown
        client:load
        items={userItems}
        triggerIconHtml={userIconSvg}
      />
    </div>    

    <button
      class="mobile-toggle"
      id="toggle"
      aria-label="Abrir menu"
      aria-expanded="false"
      aria-controls="menu"
    >
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
    </button>
  </div>
</header>

<script>
  // Mobile hamburger toggle
  const toggle = document.getElementById('toggle');
  const menu = document.getElementById('menu');
  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const isOpen = menu.classList.toggle('active');
      toggle.classList.toggle('open');
      toggle.setAttribute('aria-expanded', String(isOpen));
    });

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        menu.classList.remove('active');
        toggle.classList.remove('open');
        toggle.setAttribute('aria-expanded', 'false');
      });
    });
  }

  // Nav dropdown click toggle (Academia / Actividades)
  document.querySelectorAll<HTMLElement>("[data-nav-dropdown]").forEach((wrapper) => {
    const trigger = wrapper.querySelector<HTMLElement>("[data-nav-dropdown-trigger]");
    const panel = wrapper.querySelector<HTMLElement>(".nav-dropdown-panel");
    if (!trigger || !panel) return;

    const triggerEl = trigger!;

    function open() {
      wrapper.classList.add("open");
      triggerEl.setAttribute("aria-expanded", "true");
    }

    function close() {
      wrapper.classList.remove("open");
      triggerEl.setAttribute("aria-expanded", "false");
    }

    trigger.addEventListener("click", (e) => {
      e.preventDefault();
      e.stopPropagation();
      // Cerrar los demas dropdowns antes de abrir este
      document.querySelectorAll<HTMLElement>("[data-nav-dropdown]").forEach((other) => {
        if (other !== wrapper && other.classList.contains("open")) {
          const ot = other.querySelector<HTMLElement>("[data-nav-dropdown-trigger]");
          other.classList.remove("open");
          ot?.setAttribute("aria-expanded", "false");
        }
      });
      wrapper.classList.contains("open") ? close() : open();
    });

    panel.addEventListener("click", (e) => {
      e.stopPropagation();
    });

    document.addEventListener("click", () => {
      if (wrapper.classList.contains("open")) close();
    });

    document.addEventListener("keydown", (e: KeyboardEvent) => {
      if (e.key === "Escape" && wrapper.classList.contains("open")) close();
    });

    panel.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        close();
        if (menu && toggle) {
          menu.classList.remove("active");
          toggle.classList.remove("open");
          toggle.setAttribute("aria-expanded", "false");
        }
      });
    });
  });
</script>
