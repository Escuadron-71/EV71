---
import Icon from "@/components/UI/Icon.astro";
import { resolvePath } from "@/lib/base-url";

const navItems = [
  { label: "Inicio", href: resolvePath("/"), active: true },
  { label: "Nosotros", href: resolvePath("/#nosotros") },
  { label: "Academia", href: resolvePath("/login") },
  { label: "Flota", href: resolvePath("/#flota") },
  { label: "Operaciones", href: resolvePath("/#operaciones") },
  { label: "Galeria", href: resolvePath("/#galeria") }
];
---

{/* Para el header es muy importante crear una estructura para Dropdowns reusable */}
{/* Debedesera cordecon lamisma linea dedeiseño de la pagina y todo adapatable a dispositivos mobile */}

<header class="site-header">
  <div class="header-inner">
    <a href={resolvePath("/")} class="brand">
      <div class="brand-logo">
        <img src={`${resolvePath("/")}assets/images/logo.png`} alt="Escudo EV71" />
      </div>
      <div class="brand-text">
        <span class="brand-name">ESCUADRÓN <strong>71</strong></span>
        <span class="brand-sub">Comunidad de aviación virtual</span>
      </div>
    </a>

    <nav class="main-nav" id="menu" aria-label="Navegacion principal">
      {navItems.map((item) => (
        <a href={item.href} class:list={[{ active: item.active }]}>{item.label}</a>
      ))}
    </nav>

    <div class="profile flex items-center gap-2">
      <a href={resolvePath("/postulacion")} class="header-cta">
        POSTÚLATE
      </a>

      <a href={resolvePath("/#")} class="header-cta px-3!">
        <Icon name="ev71-user" size={24} fill="var(--color-secondary)" />
        <span class="sr-only">Cuenta</span>
        {/* En este campo,esnecesario que agregemos un Dropdown */}
        {/* El Dropdown tiene como fin, mostrar  varias opciones */}
        {/* Las opciones seran: lenguaje, cuenta, logout y talvez otra ocpion que no reconozco en este momento */}
      </a>  
    </div>    

    <button
      class="mobile-toggle"
      id="toggle"
      aria-label="Abrir menu"
      aria-expanded="false"
      aria-controls="menu"
    >
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
    </button>
  </div>
</header>

<script>
  const toggle = document.getElementById('toggle');
  const menu = document.getElementById('menu');
  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const isOpen = menu.classList.toggle('active');
      toggle.classList.toggle('open');
      toggle.setAttribute('aria-expanded', String(isOpen));
    });

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        menu.classList.remove('active');
        toggle.classList.remove('open');
        toggle.setAttribute('aria-expanded', 'false');
      });
    });
  }
</script>
