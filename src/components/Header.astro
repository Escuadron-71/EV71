---
import UserDropdown from "@/islands/UserDropdown.tsx";
import { buildNav, type NavItem } from "@/lib/navigation";
import { resolvePath } from "@/lib/base-url";

const nav = buildNav(Astro.url.pathname);

const svgModules = import.meta.glob("/src/assets/icons/*.svg", {
  query: "?raw",
  import: "default",
  eager: true,
});

let userIconSvg = "";
for (const [key, value] of Object.entries(svgModules)) {
  if (key.includes("ev71-user")) {
    userIconSvg = (value as string)
      .replace(/\s*class="[^"]*"/, "")
      .replace(/<svg\b/, '<svg width="24" height="24" fill="var(--color-secondary)"');
    break;
  }
}

const userItems = [
  { label: "Idioma", href: resolvePath("/#") },
  { separator: true as const },
  { label: "Iniciar sesión", href: resolvePath("/login") },
  { label: "Cerrar sesión", href: resolvePath("/#") },
];

const isSeparator = (item: NavItem): item is Extract<NavItem, { separator: true }> =>
  "separator" in item;
---

<header class="site-header">
  <div class="header-top">
    <a href={resolvePath("/")} class="brand">
      <div class="brand-logo">
        <img src={`${resolvePath("/")}assets/images/logo.png`} alt="Escudo EV71" />
      </div>
      <div class="brand-text">
        <span class="brand-name">ESCUADRÓN <strong>71</strong></span>
        <span class="brand-sub">Comunidad Colombiana de aviación virtual</span>
      </div>
    </a>

    <div class="header-actions">
      <a href={resolvePath("/postulacion")} class="header-cta">
        POSTÚLATE
      </a>

      <UserDropdown
        client:load
        items={userItems}
        triggerIconHtml={userIconSvg}
      />
    </div>

    <button
      class="mobile-toggle"
      id="toggle"
      aria-label="Abrir menu"
      aria-expanded="false"
      aria-controls="menu"
    >
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
    </button>
  </div>

  <div class="header-subnav">
    <nav class="main-nav" id="menu" aria-label="Navegacion principal">
      {nav.map((entry) =>
        entry.type === "link" ? (
          <a
            href={entry.href}
            class:list={[{ active: entry.active }]}
            aria-current={entry.active ? "page" : undefined}
          >
            {entry.label}
          </a>
        ) : (
          <div class="nav-dropdown" data-nav-dropdown>
            <button
              class="nav-dropdown-trigger"
              data-nav-dropdown-trigger
              aria-haspopup="true"
              aria-expanded="false"
              class:list={[{ "is-active": entry.active }]}
            >
              {entry.label}
              <svg class="chevron" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M1 1l4 4 4-4" />
              </svg>
            </button>
            <div class="nav-dropdown-panel dropdown-panel" role="menu" aria-label={entry.label}>
              {entry.items?.map((item) => {
                if (isSeparator(item)) {
                  return <div class="dropdown-separator" role="separator" />;
                }
                return (
                  <a
                    href={item.href}
                    class:list={["dropdown-item", { active: item.active }]}
                    role="menuitem"
                    aria-current={item.active ? "page" : undefined}
                  >
                    {item.label}
                  </a>
                );
              })}
            </div>
          </div>
        ),
      )}
    </nav>
  </div>
</header>

<script>
  // Mobile hamburger toggle
  const toggle = document.getElementById('toggle');
  const menu = document.getElementById('menu');
  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const isOpen = menu.classList.toggle('active');
      toggle.classList.toggle('open');
      toggle.setAttribute('aria-expanded', String(isOpen));
    });

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        menu.classList.remove('active');
        toggle.classList.remove('open');
        toggle.setAttribute('aria-expanded', 'false');
      });
    });
  }

  // Nav dropdown click toggle
  document.querySelectorAll<HTMLElement>("[data-nav-dropdown]").forEach((wrapper) => {
    const trigger = wrapper.querySelector<HTMLElement>("[data-nav-dropdown-trigger]");
    const panel = wrapper.querySelector<HTMLElement>(".nav-dropdown-panel");
    if (!trigger || !panel) return;

    const triggerEl = trigger!;

    function open() {
      wrapper.classList.add("open");
      triggerEl.setAttribute("aria-expanded", "true");
    }

    function close() {
      wrapper.classList.remove("open");
      triggerEl.setAttribute("aria-expanded", "false");
    }

    trigger.addEventListener("click", (e) => {
      e.preventDefault();
      e.stopPropagation();
      // Cerrar los demas dropdowns antes de abrir este
      document.querySelectorAll<HTMLElement>("[data-nav-dropdown]").forEach((other) => {
        if (other !== wrapper && other.classList.contains("open")) {
          const ot = other.querySelector<HTMLElement>("[data-nav-dropdown-trigger]");
          other.classList.remove("open");
          ot?.setAttribute("aria-expanded", "false");
        }
      });
      wrapper.classList.contains("open") ? close() : open();
    });

    panel.addEventListener("click", (e) => {
      e.stopPropagation();
    });

    document.addEventListener("click", () => {
      if (wrapper.classList.contains("open")) close();
    });

    document.addEventListener("keydown", (e: KeyboardEvent) => {
      if (e.key === "Escape" && wrapper.classList.contains("open")) close();
    });

    panel.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        close();
        if (menu && toggle) {
          menu.classList.remove("active");
          toggle.classList.remove("open");
          toggle.setAttribute("aria-expanded", "false");
        }
      });
    });
  });
</script>
